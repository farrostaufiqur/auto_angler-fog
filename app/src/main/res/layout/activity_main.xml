<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/screen_bg">

    <!-- Left column: info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AutoAngler"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Waiting for permission..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap control mode"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_mode_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Root (su / input tap)"
                android:textColor="@color/text_secondary" />

            <RadioButton
                android:id="@+id/rb_mode_a11y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Non-Root (Accessibility)"
                android:textColor="@color/text_secondary" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_license_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Trial"
            android:textSize="13sp"
            android:textColor="@color/status_trial"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_trial_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trial mode: the bot stops automatically after 3 minutes of fishing.\nEnter a registration code to unlock full mode."
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_reg_code"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Registration code (10 digits)"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:maxLength="10"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Register"
            android:backgroundTint="@color/btn_register"
            android:layout_marginBottom="16dp" />

        <!-- Always visible, not gated by license state -->
        <Button
            android:id="@+id/btn_about"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="About"
            android:backgroundTint="@color/btn_about" />

    </LinearLayout>

    <!-- Right column: actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp">

        <Button
            android:id="@+id/btn_grant_overlay"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="1. Grant Overlay Permission"
            android:backgroundTint="@color/btn_grant"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_start_service"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="2. Start Overlay Service"
            android:backgroundTint="@color/btn_start"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_stop_service"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Stop Service"
            android:backgroundTint="@color/btn_stop_service"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_view_log"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="View Log"
            android:backgroundTint="@color/btn_log"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Once the service is running, the HUD appears over the game.\nPick the tap control mode on the left before you start."
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
